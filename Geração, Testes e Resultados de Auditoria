import csv
import math
import random

# Definindo a semente para garantir 100% de reprodutibilidade
random.seed(42)
n_linhas = 500000

print("=" * 85)
print(
    "  SISTEMA UNIFICADO DE AUDITORIA CONTINUA: VIBRA ENERGIA S.A. (EXERCÍCIO"
    " 2025)"
)
print("=" * 85)

# ==============================================================================
# ETAPA 1: GERAÇÃO DA BASE SIMULADA DO IMOBILIZADO (500.000 REGISTROS)
# ==============================================================================
print("\n[ETAPA 1/4] Gerando base de dados analítica de 500.000 registros...")

centros_custo = [
    "CC-RIO-01 (Matriz)",
    "CC-SP-02 (Base Paulínia)",
    "CC-BA-03 (Base Candeias)",
    "CC-MG-04 (Base Betim)",
    "CC-RS-05 (Base Canoas)",
]
pesos_cc = [0.3, 0.3, 0.2, 0.1, 0.1]

categorias = [
    "Tanques e Equipamentos de Base",
    "Edificações e Benfeitorias",
    "Bombas e Unidades de Abastecimento",
    "Móveis e Utensílios",
    "Equipamentos de Informática",
]
pesos_cat = [0.4, 0.2, 0.2, 0.1, 0.1]

# Gerando distribuição de custos ajustada para bater com a Nota 13 (R$ 22.578 mi Bruto)
custos_brutos_raw = [
    math.exp(random.normalvariate(9.5, 1.2)) for _ in range(n_linhas)
]
soma_raw = sum(custos_brutos_raw)
fator_escala = 22578000000.0 / soma_raw

# Selecionando 50 posições aleatórias para inserção de exceções de teste
indices_erros = set(random.sample(range(n_linhas), 50))

base_dados = []
totais_categoria = {
    cat: {"custo": 0.0, "depr": 0.0, "liquido": 0.0, "qtd": 0}
    for cat in categorias
}

for i in range(n_linhas):
  id_bem = f"IMOB-{i+1:07d}"
  cc = random.choices(centros_custo, weights=pesos_cc)[0]
  cat = random.choices(categorias, weights=pesos_cat)[0]

  custo = round(custos_brutos_raw[i] * fator_escala, 2)
  vida_util = random.choice([10, 20, 30, 40])
  anos_uso = random.randint(1, 15)

  # Cálculo da depreciação
  if i in indices_erros:
    # Anomalia intencional: Depreciação superior ao custo (105%)
    depr = round(custo * 1.05, 2)
    inconsistente = 1
  else:
    depr = round(min(custo * 0.95, custo * (anos_uso / (vida_util + 1))), 2)
    inconsistente = 0

  liquido = round(custo - depr, 2)

  # Registrando linha da base
  base_dados.append([
      id_bem,
      cc,
      cat,
      custo,
      depr,
      liquido,
      vida_util,
      anos_uso,
      inconsistente,
  ])

  # Acumulando para a conciliação por categoria
  totais_categoria[cat]["custo"] += custo
  totais_categoria[cat]["depr"] += depr
  totais_categoria[cat]["liquido"] += liquido
  totais_categoria[cat]["qtd"] += 1

# Exportando Base Principal
nome_arq_base = "base_analitica_imobilizado_500k.csv"
headers_base = [
    "ID_Bem",
    "Centro_Custo",
    "Categoria",
    "Custo_Aquisicao_BRL",
    "Depreciacao_Acumulada_BRL",
    "Valor_Contabil_Liquido_BRL",
    "Anos_Vida_Util",
    "Anos_Uso",
    "Inconsistencia_Detectada",
]

with open(nome_arq_base, "w", newline="", encoding="utf-8-sig") as f:
  w = csv.writer(f)
  w.writerow(headers_base)
  w.writerows(base_dados)

print(f" -> Base criada e salva como '{nome_arq_base}'.")

